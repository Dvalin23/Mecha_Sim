{
  "name": "mechasim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based 2D physics + virtual mechatronics emulator with a Node/Express sharing pipeline.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
